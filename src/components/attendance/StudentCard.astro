<script>
  const container = document.getElementById('student-data-card');

  function formatJam(jam){
    if (!jam) return '-';
    return jam;
  }

  document.addEventListener('absensi-berhasil', (event) => {
    const dataAbsensi = event.detail;
    const siswa = dataAbsensi.siswa;
    container.innerHTML = `
      <div class="items-center justify-center mb-[2vh] mx-20">
        <img 
          src="./src/assets/images.jpeg" 
          alt="Student Photo" 
          class="w-[max(50px,15vw)] h-[max(50px,15vw)] rounded-full object-cover border-4 border-white shadow-[0_4px_15px_rgba(0,0,0,0.2)]"
        />
      </div>
      <h2 class="text-[max(18px,2vw)] font-medium">
        ${siswa.nama}
      </h2>
      <p class="text-lg opacity-90">
        Kelas: ${siswa.kelas.kelas}
      </p>
      <p class="text-lg opacity-90">
        Waktu Tap In: ${formatJam(dataAbsensi.tap_in)}
      </p>
      <p class="text-lg opacity-90">
        Waktu Tap Out: ${formatJam(dataAbsensi.tap_out)}
      </p>
    `;
  });

  document.addEventListener('absensi-gagal', (event) => {
    if (!container) return;
    const detail = event.detail || {};
    const message = detail.message || "Absensi Gagal";
    const isTapOut = detail.isTapOut || false;
    
    // Provide more helpful error messages
    let errorMessage = message;
    if (message.includes("sudah")) {
      errorMessage = isTapOut ? "Anda sudah melakukan tap out hari ini." : "Anda sudah melakukan tap in hari ini.";
    }
    
    container.innerHTML = `
      <div class="items-center justify-center mb-[2vh] mx-20">
        <img 
          src="./src/assets/warn.png" 
          alt="Error Icon" 
          class="w-[max(50px,15vw)] h-[max(50px,15vw)] object-cover"
        />
      </div>
      <p class="text-[max(6px,1.2vw)] font-medium text-white-500">
        ${errorMessage}
      </p>
    `;
  });
</script>

