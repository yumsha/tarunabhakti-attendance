---
const student = {
  name: "Muhamad Riza Pahlevi",
  nis: "12345678",
  class: "XI RPL 4",
}
---

<div class="relative w-full max-w-[65vh] h-[90vh] aspect-[4/5] rounded-[60px] bg-gradient-to-b from-[#4b89bd] to-[#356792] flex items-center justify-center text-white p-[5%] overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.1)] ml-[30vh]">
  <div class="absolute w-[120px] h-[50px] bottom-[80px] -left-[20px] rounded-[50px] bg-white filter drop-shadow-[2px_4px_6px_rgba(0,0,0,0.05)]"
    style="box-shadow: 30px -25px 0 5px white, 70px -10px 0 -5px white;">
  </div>
  
  <div class="absolute w-[100px] h-[40px] top-[60px] -right-[15px] rounded-[40px] bg-white filter drop-shadow-[2px_4px_6px_rgba(0,0,0,0.05)]"
    style="box-shadow: -20px -20px 0 8px white, -55px -5px 0 -2px white;">
  </div>

  {student ? (
    <div class="text-center z-10">
      <div class="items-center justify-center mb-[2vh] mx-20">
        <img 
          src="./src/assets/images.jpeg" 
          alt="Student Photo" 
          class="w-[max(50px,15vw)] h-[max(50px,15vw)] rounded-full object-cover border-4 border-white shadow-[0_4px_15px_rgba(0,0,0,0.2)]"
        />
      </div>
      <h2 class="text-[max(18px,2vw)] font-medium">
        {student.name}
      </h2>
      <p class="text-lg opacity-90">
        NIS: {student.nis}
      </p>
      <p class="text-lg opacity-90">
        Kelas: {student.class}
      </p>
      <p class="text-lg opacity-90">
        Waktu Tap In: 06.20
      </p>
    </div>
  ) : (
    <div class="text-center z-10 opacity-80">
      <p class="text-[max(12px,1.4vw)] font-medium">
        Data Siswa akan ditampilkan disini
      </p>
    </div>
  )}
</div>
