<script>
  type AttendanceDetail = {
    siswa: {
      nama: string;
      kelas: {
        kelas: string;
        jurusan: {
          nama_jurusan: string;
        }
      };
    };
    tap_in?: string | null;
    tap_out?: string | null;
  };

  type AttendanceErrorDetail = {
    message?: string;
  };

  const container = document.getElementById('student-data-card');

  function formatJam(jam: string | null | undefined): string {
    if (!jam) return '-';
    return jam;
  }

  document.addEventListener('absensi-berhasil', (event) => {
    if (!container) return;
    const dataAbsensi = (event as CustomEvent<AttendanceDetail>).detail;
    const siswa = dataAbsensi.siswa;
    container.innerHTML = `
      <h2 class="text-[max(18px,2vw)] font-medium">
        ${siswa.nama}
      </h2>
      <p class="text-lg opacity-90">
        Kelas: ${siswa.kelas.kelas} ${siswa.kelas.jurusan}
      </p>
      <p class="text-lg opacity-90">
        Waktu Tap In: ${formatJam(dataAbsensi.tap_in)}
      </p>
      <p class="text-lg opacity-90">
        Waktu Tap Out: ${formatJam(dataAbsensi.tap_out)}
      </p>
    `;
  });

  document.addEventListener('absensi-gagal', (event) => {
    if (!container) return;
    const detail = (event as CustomEvent<AttendanceErrorDetail>).detail || {};
    const errorMessage = detail.message || "Absensi Gagal";

    container.innerHTML = `
      <div class="items-center justify-center mb-[2vh] mx-20">
        <img 
          src="/warn.webp" 
          alt="Error Icon" 
          class="w-[max(50px,15vw)] h-[max(50px,15vw)] object-cover"
        />
      </div>
      <p class="text-[max(6px,1.2vw)] font-medium text-white-500">
        ${errorMessage}
      </p>
    `;
  });
</script>

