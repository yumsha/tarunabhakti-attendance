---
const stats = {
  totalStudents: 201,
  present: 190,
  absent: 6,
  izin: 5,
};
---

<div class="bg-white rounded-lg shadow p-6 mb-8">
  <h3 class="text-lg font-semibold mb-4">Data Kehadiran Hari Ini</h3>
  <div class="grid grid-cols-2 gap-4">
    <div class="bg-green-50 p-4 rounded">
      <span class="text-sm text-gray-700">Hadir</span>
      <div class="text-2xl font-bold text-green-700">{stats.present}</div>
    </div>
    <div class="bg-red-50 p-4 rounded">
      <span class="text-sm text-gray-700">Absen (Alfa)</span>
      <div class="text-2xl font-bold text-red-700">{stats.absent}</div>
    </div>
    <div class="bg-yellow-50 p-4 rounded">
      <span class="text-sm text-gray-700">Izin</span>
      <div class="text-2xl font-bold text-yellow-700">{stats.izin}</div>
    </div>
    <div class="bg-blue-50 p-4 rounded">
      <span class="text-sm text-gray-700">Sakit</span>
      <div class="text-2xl font-bold text-blue-700">{stats.totalStudents}</div>
    </div>
  </div>
</div>
