---
const recentAttendance = [
  { name: "Riza Pahlevi", time: "06:20", status: "Present" },
  { name: "Dewi Lestari", time: "06:22", status: "Present" },
  { name: "Budi Santoso", time: "06:25", status: "Absent" },
  { name: "Siti Aminah", time: "06:30", status: "Izin" },
];
---

<div class="bg-white rounded-lg shadow p-6 mb-8">
  <h3 class="text-lg font-semibold mb-4">Recent Attendance</h3>
  <ul>
    {recentAttendance.map((item) => (
      <li class="flex items-center justify-between py-2 border-b last:border-none">
        <span class="font-medium">{item.name}</span>
        <span class="text-sm text-gray-500">{item.time}</span>
        <span class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-700" style={item.status === "Absent" ? "background-color:#fee2e2;color:#b91c1c" : item.status === "Izin" ? "background-color:#fef9c3;color:#b45309" : ""}>{item.status}</span>
      </li>
    ))}
  </ul>
</div>
