---

---

<div
  class="flex flex-col items-center justify-center text-center h-full ml-[25vh]"
>
  <img
    src="/logo.png"
    alt="Starbhak Attendance Logo"
    class="w-[min(140px,12vw)] mb-[2.5vh]"
  />

  <img
    src="/rfid.png"
    alt="RFID Scanner"
    class="w-[min(160px,14vw)] mb-[10vh] mt-[5vh]"
  />

  <input
    id="rfid-input"
    type="text"
    placeholder="Tap Kartu ke RFID Scanner"
    class="w-62 text-gray-500 bg-white rounded-full px-2 py-3 text-center"
    autofocus
  />

  <script>
    // /home/yumsha/Projects/tarunabhakti-attendance/src/components/attendance/Rfidscanner.astro

    const RFID_CACHE_KEY = "rfid_cache";
    const RFID_CACHE_TS_KEY = "rfid_cache_ts";
    const RFID_CACHE_TTL_MS = 60_000;
    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

    function readCachedRfidMap() {
      const tsRaw = localStorage.getItem(RFID_CACHE_TS_KEY);
      const raw = localStorage.getItem(RFID_CACHE_KEY);
      if (!tsRaw || !raw) return null;

      const ts = Number(tsRaw);
      if (!Number.isFinite(ts) || Date.now() - ts > RFID_CACHE_TTL_MS) {
        localStorage.removeItem(RFID_CACHE_KEY);
        localStorage.removeItem(RFID_CACHE_TS_KEY);
        return null;
      }

      try {
        return JSON.parse(raw);
      } catch {
        localStorage.removeItem(RFID_CACHE_KEY);
        localStorage.removeItem(RFID_CACHE_TS_KEY);
        return null;
      }
    }

    // Load RFID lalu simpan ke localstorage sebagai object
    async function loadRfidCache() {
      try {
        const cachedMap = readCachedRfidMap();
        if (cachedMap) {
          console.log("RFID cache loaded from storage");
          return cachedMap;
        }

        const response = await fetch(`${API_BASE_URL}/api/v1/rfid/load-Rfid`);
        if (!response.ok) throw new Error("Gagal mengambil data RFID");

        const result = await response.json();
        // Simpan sebagai object
        const cacheMap: Record<string, string> = {};
        for (const item of result.data) {
          cacheMap[item.uid_rfid] = item.nama;
        }

        localStorage.setItem(RFID_CACHE_KEY, JSON.stringify(cacheMap));
        localStorage.setItem(RFID_CACHE_TS_KEY, String(Date.now()));
        console.log(`RFID cache loaded: ${result.data.length} kartu`);
        return cacheMap;
      } catch (error) {
        console.error("Gagal load RFID cache:", error);
        return readCachedRfidMap();
      }
    }

    // Ambil nama siswa dari cache berdasarkan uid_rfid
    function getNamaFromCache(uid_rfid: string): string | null {
      const raw = localStorage.getItem(RFID_CACHE_KEY);
      if (!raw) return null;
      const cacheMap: Record<string, string> = JSON.parse(raw);
      return cacheMap[uid_rfid] ?? null;
    }

    function initializeRfidScanner() {
      const rfidInput = document.getElementById(
        "rfid-input",
      ) as HTMLInputElement;

      if (!rfidInput) {
        console.error("RFID input element not found");
        return;
      }

      rfidInput.addEventListener("keydown", async (event) => {
        if (event.key === "Enter") {
          const uid_rfid = rfidInput.value.trim();
          if (!uid_rfid) return;

          // Cek dulu di cache
          const nama = getNamaFromCache(uid_rfid);
          if (!nama) {
            document.dispatchEvent(
              new CustomEvent("absensi-gagal", {
                detail: { message: "Kartu RFID tidak dikenali" },
              }),
            );
            rfidInput.value = "";
            rfidInput.focus();
            return;
          }

          // mode menandai endpoint mana yang sedang aktif menentukan hasil,
          // supaya listener tahu ini hasil tap-in atau tap-out (bukan cuma
          // menebak dari status_tapin yang null di respons tap-out)
          let mode: "tap_in" | "tap_out" = "tap_in";

          try {
            let response = await fetch(
              `${API_BASE_URL}/api/v1/absensi-siswa/tap-in`,
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ uid_rfid }),
              },
            );

            // Backend: tap-in balas 409 hanya untuk reason "already_tapped_in".
            // Itu sinyal siswa sudah tap-in hari ini -> coba tap-out.
            if (response.status === 409) {
              mode = "tap_out";
              response = await fetch(
                `${API_BASE_URL}/api/v1/absensi-siswa/tap-out`,
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ uid_rfid }),
                },
              );
            }

            if (response.ok) {
              const result = await response.json();
              const dataAbsensi = result.data;
              document.dispatchEvent(
                new CustomEvent("absensi-berhasil", {
                  detail: { ...dataAbsensi, mode },
                }),
              );
            } else {
              const errorData = await response.json().catch(() => ({}));
              const errorMessage = errorData.message || response.statusText;

              document.dispatchEvent(
                new CustomEvent("absensi-gagal", {
                  detail: { message: errorMessage, mode },
                }),
              );
            }
          } catch (error) {
            document.dispatchEvent(
              new CustomEvent("absensi-gagal", {
                detail: { message: error.message, mode },
              }),
            );
            console.error("Error Absensi:", error);
          } finally {
            rfidInput.value = "";
            rfidInput.focus();
          }
        }
      });

      document.addEventListener("click", () => rfidInput?.focus());
      rfidInput.focus();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        loadRfidCache();
        initializeRfidScanner();
      });
    } else {
      loadRfidCache();
      initializeRfidScanner();
    }
  </script>
</div>