---
const lateStudents = [
  { name: "Budi Santoso", class: "XI RPL 4", time: "07:05" },
  { name: "Siti Aminah", class: "XI RPL 3", time: "07:10" },
  { name: "Andi Wijaya", class: "XI RPL 2", time: "07:15" },
];
---

<div class="bg-white rounded-lg shadow p-6 mb-8">
  <h3 class="text-lg font-semibold mb-4">Siswa Terlambat Hari Ini</h3>
  <ul>
    {lateStudents.length === 0 ? (
      <li class="text-gray-500">No late students today.</li>
    ) : (
      lateStudents.map((student) => (
        <li class="flex items-center justify-between py-2 border-b last:border-none">
          <div>
            <span class="font-medium">{student.name}</span>
            <span class="ml-2 text-xs text-gray-400">({student.class})</span>
          </div>
          <span class="text-xs px-2 py-1 rounded-full bg-red-100 text-red-700">{student.time}</span>
        </li>
      ))
    )}
  </ul>
</div>
