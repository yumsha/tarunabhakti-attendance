---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import WalasKenaikanKelas from "../../components/walas/WalasKenaikanKelas.jsx";
---

<BaseLayout requireAuth={true} title="Sortir Kenaikan Kelas - Wali Kelas">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load allowedRoles={['WALAS', 'ADMIN', 'SUPERADMIN', 'SUPER_ADMIN']}>
      <WalasKenaikanKelas client:load />
    </AuthGate>
  </div>
</BaseLayout>
