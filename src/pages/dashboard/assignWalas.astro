---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import AssignWalasKelas from "../../components/superAdmin/AssignWalasKelas.jsx";
---

<BaseLayout title="Assign Walas">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load allowedRoles={["SUPERADMIN"]}>
      <AssignWalasKelas client:load />
    </AuthGate>
  </div>
</BaseLayout>
