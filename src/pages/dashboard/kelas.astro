---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import DaftarSemuaKelas from "../../components/attendance/DaftarSemuaKelas";
---

<BaseLayout title="Manajemen Kelas">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load allowedRoles={["SUPERADMIN"]}>
      <DaftarSemuaKelas client:load />
    </AuthGate>
  </div>
</BaseLayout>
