---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AttendanceMain from "../../components/attendance/AttendanceMain.jsx";
import AuthGate from "../../components/auth/AuthGate.jsx";
---

<BaseLayout requireAuth={true} title="Kehadiran">
  <div class="flex h-screen bg-gray-50">
    <Sidebar />
    <AuthGate client:load allowedRoles={["GURU"]}>
      <AttendanceMain client:load />
    </AuthGate>
  </div>
</BaseLayout>
