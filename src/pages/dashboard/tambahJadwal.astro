---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import DaftarJadwal from "../../components/attendance/DaftarJadwal";
import AuthGate from "../../components/auth/AuthGate.jsx";
---

<BaseLayout requireAuth={true} title="Tambah Jadwal">
  <div class="flex h-screen bg-gray-50">
    <Sidebar />
    <AuthGate client:load allowedRoles={["ADMIN", "SUPERADMIN", "KESISWAAN"]}>
      <DaftarJadwal client:load />
    </AuthGate>
  </div>
</BaseLayout>
