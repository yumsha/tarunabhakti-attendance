---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import RiwayatKehadiranPage from "../../components/feat/riwayatKehadiran/RiwayatKehadiranPage.jsx";
---

<BaseLayout requireAuth={true} title="Riwayat Kehadiran - Starbhak Attendance">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load>
      <RiwayatKehadiranPage client:load />
    </AuthGate>
  </div>
</BaseLayout>
