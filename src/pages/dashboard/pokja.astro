---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import PokjaAttendanceManage from "../../components/attendance/PokjaAttendanceManage";
---

<BaseLayout requireAuth={true} title="Detail Absensi">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load allowedRoles={["KESISWAAN"]}>
      <PokjaAttendanceManage client:load />
    </AuthGate>
  </div>
</BaseLayout>

