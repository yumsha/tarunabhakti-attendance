---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import AuthGate from "../../components/auth/AuthGate.jsx";
import WalasDashboard from "../../components/dashboard/WalasDashboard.jsx";
---

<BaseLayout requireAuth={true} title="Kelola User">
  <div class="flex h-screen bg-gray-50 overflow-hidden">
    <Sidebar />

    <AuthGate client:load allowedRoles={['WALAS']}>
      <WalasDashboard client:load />
    </AuthGate>
  </div>
</BaseLayout>
