---
import BaseLayout from "../layouts/BaseLayout.astro"
import LoginForm from "../components/auth/LoginForm.jsx"
---

<BaseLayout requireGuest={true} title="Login - TB Attendance">
  <div class="min-h-screen flex bg-gradient-to-br from-[#5B9BD5] via-[#4A8BC2] to-[#2D5F7F]">
    <div class="hidden lg:flex w-[55%] relative overflow-hidden flex-col justify-between p-16 text-white">
      <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
        <svg
          class="w-full h-full"
          viewBox="0 0 800 800"
          fill="none"
          stroke="white"
          stroke-width="1.5"
        >
          <path d="M-100,-100 L400,200 C500,260 550,400 500,600 L400,900" />
          <path d="M-100,-50 L350,250 C450,310 500,450 450,650 L350,950" />
          <path d="M-100,0 L300,300 C400,360 450,500 400,700 L300,1000" />
          <path d="M-100,50 L250,350 C350,410 400,550 350,750 L250,1050" />
          <path d="M-100,100 L200,400 C300,460 350,600 300,800 L200,1100" />

          <path d="M-100,200 L400,-100" stroke-width="1" opacity="0.5" />
          <path d="M-100,300 L500,-100" stroke-width="1" opacity="0.5" />
          <path d="M-100,400 L600,-100" stroke-width="1" opacity="0.5" />
        </svg>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 mt-12">
        
        <!-- Logo -->
        <div class="mb-14">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-20 h-20"
          >
            <line x1="12" y1="2" x2="12" y2="22"></line>
            <line x1="3.34" y1="7" x2="20.66" y2="17"></line>
            <line x1="3.34" y1="17" x2="20.66" y2="7"></line>
          </svg>
        </div>

        <h1 class="text-[64px] font-bold mb-6 leading-[1.15] tracking-tight">
          Selamat Datang,
          <br />
          Starbhak People!
        </h1>

        <p class="text-[18px] text-white/90 max-w-[460px] leading-[1.6]">
          Pantau Kehadiran dengan mudah dan efisien menggunakan Sistem. Solusi modern untuk manajemen kehadiran yang lebih baik.
        </p>
      </div>

      <!-- Footer -->
      <div class="relative z-10 text-[15px] text-white/60 font-light tracking-wide">
        © 2026 Riza Pahlevi
      </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="flex flex-1 items-center justify-center px-6 py-12">
      <div class="bg-white rounded-3xl shadow-2xl p-10 w-full max-w-md">
        
        <div class="mb-10">
          <h1 class="text-2xl font-bold text-gray-900">STARBHAK</h1>
          <h2 class="text-2xl font-normal text-gray-700">
            Attendance System
          </h2>
        </div>

        <LoginForm client:load />
      </div>
    </div>

  </div>
</BaseLayout>