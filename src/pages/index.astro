---
import BaseLayout from "../layouts/BaseLayout.astro";
import RfidScanner from "../components/attendance/Rfidscanner.astro";
import StudentCard from "../components/attendance/StudentCard.astro";
---

<BaseLayout title="Attendance">
  <div class="grid gap-[30px] p-[30px] h-screen items-center justify-items-center bg-[url('src/assets/bg-1.png')] bg-cover bg-center overflow-hidden md:grid-cols-1 md:gap-[15px] md:p-[15px] sm:gap-[10px] sm:p-[10px]" style="grid-template-columns: 1fr 1.5fr;">
    <section class="flex justify-center items-center w-full h-full">
      <RfidScanner />
    </section>

    <section class="flex justify-center items-center w-full h-full">
      <StudentCard />
    </section>
  </div>
</BaseLayout>