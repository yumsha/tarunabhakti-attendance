---
import "../styles/globals.css";
import { ClientRouter } from 'astro:transitions';
const { title = "Starbhak Attendance", requireAuth = false, requireGuest = false } = Astro.props;
---
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <title>{title}</title>
    <ClientRouter />

    {requireAuth && (
      <script is:inline>
        (function () {
          function hasValidSession() {
            const token = localStorage.getItem('accessToken');
            const userStr = localStorage.getItem('user');

            if (!token || !userStr) return false;

            try {
              JSON.parse(userStr);
              return true;
            } catch {
              return false;
            }
          }

          function clearAuth() {
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            localStorage.removeItem('user');
            localStorage.removeItem('ysboToken');
          }

          function checkAuth() {
            if (!hasValidSession()) {
              clearAuth();
              window.location.replace('/login');
            }
          }

          // Run immediately on page load
          checkAuth();

          // Re-run after every client-side navigation, but clean up first
          // to avoid stacking listeners across navigations
          function onAfterSwap() {
            checkAuth();
          }

          document.removeEventListener('astro:after-swap', onAfterSwap);
          document.addEventListener('astro:after-swap', onAfterSwap);
        })();
      </script>
    )}

    {requireGuest && (
      <script is:inline>
        (function () {
          function hasValidSession() {
            const token = localStorage.getItem('accessToken');
            const userStr = localStorage.getItem('user');

            if (!token || !userStr) return false;

            try {
              JSON.parse(userStr);
              return true;
            } catch {
              return false;
            }
          }

          function clearAuth() {
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            localStorage.removeItem('user');
            localStorage.removeItem('ysboToken');
          }

          function checkGuest() {
            if (hasValidSession()) {
              window.location.replace('/dashboard');
            } else {
              clearAuth();
            }
          }

          // Run immediately on page load
          checkGuest();

          function onAfterSwap() {
            checkGuest();
          }

          document.removeEventListener('astro:after-swap', onAfterSwap);
          document.addEventListener('astro:after-swap', onAfterSwap);
        })();
      </script>
    )}
  </head>
  <body class="min-h-screen bg-gray-100 font-[Poppins] text-gray-800">
    <slot />
  </body>
</html>
